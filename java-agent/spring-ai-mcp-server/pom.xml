<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      与 spring-ai 模块同层级，同样独立选择 Spring Boot 基线，不继承父仓库 POM。
      刻意与 spring-ai 模块保持一致（Boot 4.1.1 + Spring AI 2.0.1），
      这样两个模块可以共用一个本地仓库缓存，也方便对照学习。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 与 spring-ai-bom 2.0.1 期望的基线一致（其 starter 显式依赖 Boot 4.1.1） -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.learning.agent</groupId>
    <artifactId>spring-ai-mcp-server</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>spring-ai-mcp-server</name>
    <description>Spring AI MCP Server 学习模块（WebMVC / Streamable-HTTP 传输）</description>

    <properties>
        <java.version>17</java.version>
        <!-- Spring AI 版本由本模块自己决定，不受根 POM 约束 -->
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          Spring AI 核心：
          - spring-ai-model  提供 @Tool / @ToolParam / ToolCallback / ToolCallbackProvider 等工具抽象
          - spring-ai-client-chat 提供 ChatClient / ChatModel 上层 API（后续接模型时会用到）
          二者都由 spring-ai-bom 管理版本。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>

        <!-- Spring AI：OpenAI 兼容模型客户端（也适用于 DeepSeek / Moonshot 等 OpenAI 兼容接口） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
          MCP Server（WebMVC 传输）：基于 Servlet + Spring MVC，无需 WebFlux。
          传递依赖里已包含 spring-boot-starter-web、spring-ai-mcp、
          spring-ai-mcp-annotations（@McpTool / @McpResource / @McpPrompt）、mcp-spring-webmvc。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- 显式声明：本模块自带 REST 端点，用于本地自检 MCP Server 状态 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lombok：版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 版本与 repackage 执行由 spring-boot-starter-parent 统一提供 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              保险：模块自管依赖版本后，若版本调解选出了比传递依赖更低的版本，
              这里会直接构建失败，而不是等到运行时才炸。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-dependency-convergence</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
