<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      与 spring-ai / spring-ai-mcp-server 同层级，独立选择 Spring Boot 基线，不继承父仓库 POM。
      Boot 4.1.1 + Spring AI 2.0.1，与另外两个模块保持一致，共用本地仓库缓存。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.learning.agent</groupId>
    <artifactId>spring-ai-mcp-server-image</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>spring-ai-mcp-server-image</name>
    <description>Spring AI MCP Server 学习模块（把 OpenAI 生图模型封装为 MCP Server）</description>

    <properties>
        <java.version>17</java.version>
        <!-- Spring AI 版本由本模块自己决定，不受根 POM 约束 -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!--
          MinIO Java SDK：用于把生成好的图片上传到对象存储。

          刻意停在 8.5.x，不要升 9.x：okhttp 从 5.x 起改成了 Kotlin Multiplatform 工程，
          Maven Central 上的 com.squareup.okhttp3:okhttp 只是一个几百字节的元数据空壳
          （只含 META-INF/kotlin-project-structure-metadata.json，没有任何 .class），
          真正的 JVM 字节码挪到了 okhttp-jvm。Gradle 会读 .module 元数据自动替换，Maven 不会，
          于是 minio 9.x 在 Maven 下编译即报：
            java: 无法访问 okhttp3.MediaType / 找不到 okhttp3.MediaType 的类文件
          而 minio 8.5.x 依赖 okhttp 4.12.0（纯 JVM jar），与
          spring-ai-openai -> openai-java-core 用的 okhttp 4.12.0 完全一致，
          全链路只有一份 okhttp3.* / okio.*，不会出现重复类。

          真要上 9.x 时的做法：显式引 com.squareup.okhttp3:okhttp-jvm，
          并把 openai-java-core 里的 okhttp 4.12.0 排除掉，否则两个版本的 okhttp3.*
          会同时躺在 classpath 上，谁生效取决于顺序，运行期随机炸。
        -->
        <minio.version>8.5.17</minio.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
              版本对齐：minio -> guava 33.3.1-jre 带的是 error_prone_annotations 2.28.0，
              而 spring-ai-openai -> openai-java-core 带的是 2.33.0，
              默认调解会选中更低的 2.28.0（maven-enforcer 的 requireUpperBoundDeps 会直接报错）。
              这里显式抬到高版本。
            -->
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>2.33.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          MCP Server（WebMVC 传输）：Servlet + Spring MVC，无需 WebFlux。
          传递依赖包含 spring-boot-starter-web、spring-ai-mcp、
          spring-ai-mcp-annotations（@McpTool / @McpResource / @McpPrompt）、mcp-spring-webmvc。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!--
          Spring AI 核心抽象：
          - spring-ai-model 提供 @Tool / @ToolParam 等工具注解（编写 MCP Tool 时需要）
          - spring-ai-client-chat 提供上层 API（当前阶段不强依赖，保留便于后续扩展）
          版本由 spring-ai-bom 管理。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>
        <!-- 显式声明：本模块自带 REST 端点，用于本地自检 MCP Server 状态 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          MinIO Java SDK：生图结果的落地存储（S3 兼容协议）。
          注意：Spring Boot 没有 MinIO 的自动装配，需要自己写 MinioClient 的 @Bean
          （见 com.learning.agent.mcp.image.config.minio）。
          版本停留在 8.5.17 的原因见上面 minio.version 处的注释。
        -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>

        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>4.76.0</version>
        </dependency>

        <!-- Lombok：版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>3.0.7</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 版本与 repackage 执行由 spring-boot-starter-parent 统一提供 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Lombok 注解处理必须显式声明。
              JDK 23 起 javac 默认不再到 classpath 上自动发现注解处理器（JDK 21 开始告警、
              23 起直接不跑），结果 Lombok 静默失效：@Data 不生成 getter/setter、
              @AllArgsConstructor 不生成构造器、@Slf4j 不生成 log 字段，编译报一堆
              “找不到符号: 变量 log / 方法 getBucketName()”。
              用 annotationProcessorPaths 而不是 <proc>full</proc>，是为了在 JDK 17 上也能构建。
              ${lombok.version} 由 spring-boot-dependencies 提供。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              保险：模块自管依赖版本后，若版本调解选出了比传递依赖更低的版本，
              这里会直接构建失败，而不是等到运行时才炸。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-dependency-convergence</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
