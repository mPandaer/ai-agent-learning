<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      与 spring-ai / spring-ai-mcp-server 同层级，独立选择 Spring Boot 基线，不继承父仓库 POM。
      Boot 4.1.1 + Spring AI 2.0.1，与另外两个模块保持一致，共用本地仓库缓存。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.learning.agent</groupId>
    <artifactId>spring-ai-mcp-server-image</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>spring-ai-mcp-server-image</name>
    <description>Spring AI MCP Server 学习模块（把 OpenAI 生图模型封装为 MCP Server）</description>

    <properties>
        <java.version>17</java.version>
        <!-- Spring AI 版本由本模块自己决定，不受根 POM 约束 -->
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          MCP Server（WebMVC 传输）：Servlet + Spring MVC，无需 WebFlux。
          传递依赖包含 spring-boot-starter-web、spring-ai-mcp、
          spring-ai-mcp-annotations（@McpTool / @McpResource / @McpPrompt）、mcp-spring-webmvc。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!--
          OpenAI 模型客户端：本模块用它调用生图接口。
          spring-ai-starter-model-openai -> spring-ai-openai（OpenAiImageModel / OpenAiImageOptions）
          + spring-ai-autoconfigure-model-openai（OpenAiImageAutoConfiguration，
          自动装配 ImageModel Bean，配置前缀 spring.ai.openai.image）。
          同样适用于任何 OpenAI 兼容的绘图接口。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
          Spring AI 核心抽象：
          - spring-ai-model 提供 @Tool / @ToolParam 等工具注解（编写 MCP Tool 时需要）
          - spring-ai-client-chat 提供上层 API（当前阶段不强依赖，保留便于后续扩展）
          版本由 spring-ai-bom 管理。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>

        <!-- 显式声明：本模块自带 REST 端点，用于本地自检 MCP Server 状态 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lombok：版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 版本与 repackage 执行由 spring-boot-starter-parent 统一提供 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              保险：模块自管依赖版本后，若版本调解选出了比传递依赖更低的版本，
              这里会直接构建失败，而不是等到运行时才炸。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-dependency-convergence</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
